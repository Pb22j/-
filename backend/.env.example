# ===== بصير — Environment Variables =====
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# لا تشارك ملف .env أبداً مع أحد!

# Gemini Live API (للدردشة الصوتية والنصية)
# احصل عليه من: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# موديل Gemini Live المستخدم
# الافتراضي: gemini-3.8-live (اللي اشتغل عندنا)
# بديل: gemini-3.1-flash-live-preview
# بديل آخر: gemini-2.0-flash-live-001
GEMINI_LIVE_MODEL=gemini-3.8-live

# MiniMax TTS/STT (اختياري - يستخدم للتعرف على الصوت العربي)
# احصل عليه من: https://minimax.io
MINIMAX_API_KEY=your_minimax_api_key_here

# إعدادات الخادم
HOST=0.0.0.0
PORT=8000
